<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChessTrainerApp.ViewModels"
             xmlns:m="clr-namespace:ChessTrainerApp.Models"
             xmlns:conv="clr-namespace:ChessTrainerApp.Converters"
             x:Class="ChessTrainerApp.ChessBoardPage"
             x:Name="ChessBoardPageRoot"
             Title="Шахова Дошка"
             BackgroundColor="#121212">

    <ContentPage.BindingContext>
        <vm:ChessBoardViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <conv:PieceColorToMauiColorConverter x:Key="PieceColorConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto, Auto" 
          ColumnDefinitions="*"
          Padding="10,5"
          VerticalOptions="Fill" 
          HorizontalOptions="Fill">

        <Border Grid.Row="0" 
                BackgroundColor="#2C2C2C" 
                Stroke="#505050"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="10,5" 
                Margin="0,0,0,5"
                HorizontalOptions="Fill">
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="🤖" FontSize="18"/>
                    <Label Text="{Binding TopPlayerName}" TextColor="#E0E0E0" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Grid.Column="1" 
                       Text="{Binding TopMaterialAdvantage}" 
                       TextColor="#FFD700" 
                       FontAttributes="Bold"
                       FontSize="16"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                x:Name="ChessBoardContainer" 
                Stroke="Gray" 
                StrokeThickness="2"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            
            <Grid x:Name="BoardGrid"
                ColumnDefinitions="*,*,*,*,*,*,*,*"
                RowDefinitions="*,*,*,*,*,*,*,*"
                BackgroundColor="#EEEED2"
                Rotation="{Binding BoardRotation}">
                
                </Grid>
        </Border>

        <Border Grid.Row="2" 
                BackgroundColor="#2C2C2C" 
                Stroke="#505050"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="10,5" 
                Margin="0,5,0,5"
                HorizontalOptions="Fill">
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="👤" FontSize="18"/>
                    <Label Text="{Binding BottomPlayerName}" TextColor="#E0E0E0" FontAttributes="Bold" FontSize="16" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Grid.Column="1" 
                       Text="{Binding BottomMaterialAdvantage}" 
                       TextColor="#FFD700" 
                       FontAttributes="Bold"
                       FontSize="16"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="3" Spacing="5" Margin="0,0,0,10">
            
            <Grid ColumnDefinitions="*, Auto, Auto, *" ColumnSpacing="8" HeightRequest="45">
 
                <Button Grid.Column="0" 
                        Text="◀" 
                        Command="{Binding PreviousMoveCommand}"
                        BackgroundColor="#3E3E3E" TextColor="White"
                        CornerRadius="8"/>
                               
                <Button Grid.Column="1" 
                        Text="↩️" 
                        Command="{Binding UndoLastMoveCommand}"
                        IsVisible="{Binding IsTrainingMode}"
                        BackgroundColor="#FF9800" TextColor="White"
                        CornerRadius="8" WidthRequest="50" Padding="0"/>

                <Button Grid.Column="2" 
                        Text="🏳️" 
                        Command="{Binding ResignGameCommand}"
                        BackgroundColor="#D32F2F" TextColor="White"
                        CornerRadius="8" WidthRequest="50" Padding="0"/>
                
                <Button Grid.Column="3" 
                        Text="▶" 
                        Command="{Binding NextMoveCommand}"
                        BackgroundColor="#3E3E3E" TextColor="White"
                        CornerRadius="8"/>
            </Grid>

            <Border BackgroundColor="#1E1E1E" 
                    Stroke="#333"
                    StrokeShape="RoundRectangle 8"
                    Padding="10" 
                    HeightRequest="80" 
                    VerticalOptions="Fill"> 
                <ScrollView>
                    <Label Text="{Binding PgnText}" 
                           TextColor="#B0B0B0" 
                           FontSize="14"
                           LineBreakMode="WordWrap"/>
                </ScrollView>
            </Border>
        </VerticalStackLayout>

        <BoxView Color="Black" Opacity="0.85" 
                 IsVisible="{Binding IsGameOver}" 
                 Grid.Row="0" Grid.RowSpan="4" 
                 InputTransparent="False"/>

        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="4"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             Spacing="25"
                             IsVisible="{Binding IsGameOver}">
            
            <Label Text="{Binding GameOverMessage}" 
                   TextColor="White" FontSize="32" FontAttributes="Bold" 
                   HorizontalTextAlignment="Center"/>

            <Button Text="🔄 Грати знову" Command="{Binding GoToSetupCommand}" 
                    BackgroundColor="#4CAF50" TextColor="White" 
                    WidthRequest="220" HeightRequest="60"
                    CornerRadius="30" FontSize="18" FontAttributes="Bold"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>