<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChessTrainerApp.ViewModels"
             xmlns:m="clr-namespace:ChessTrainerApp.Models"
             xmlns:conv="clr-namespace:ChessTrainerApp.Converters"
             x:Class="ChessTrainerApp.ArchivePage"
             Title="Архів Партій"
             BackgroundColor="#121212">

    <ContentPage.BindingContext>
        <vm:ArchiveViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <conv:WinnerConverter x:Key="WinnerConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <Label Text="Історія Ігор" 
               TextColor="White" FontSize="28" FontAttributes="Bold"
               HorizontalOptions="Center" Margin="0,15,0,10"/>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Games}" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:GameRecord">
                    
                    <Border BackgroundColor="#2C2C2C" 
                            Stroke="#404040"
                            StrokeShape="RoundRectangle 10" 
                            Margin="0,0,0,12" 
                            Padding="15">
                        
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                            
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding DatePlayed, StringFormat='📅 {0:dd MMM yyyy, HH:mm}'}" 
                                   TextColor="#A0A0A0" FontSize="12"/>

                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ., Converter={StaticResource WinnerConverter}}"
                                   TextColor="{Binding ., Converter={StaticResource WinnerConverter}, ConverterParameter='Color'}" 
                                   FontAttributes="Bold" FontSize="14"
                                   HorizontalOptions="End"/>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                                   Spacing="10" Margin="0,10">
                                <Border BackgroundColor="White" StrokeShape="RoundRectangle 4" Padding="6,2">
                                    <Label Text="{Binding WhitePlayer}" TextColor="Black" FontSize="12" FontAttributes="Bold"/>
                                </Border>
                                <Label Text="vs" TextColor="Gray" VerticalOptions="Center"/>
                                <Border BackgroundColor="Black" Stroke="Gray" StrokeShape="RoundRectangle 4" Padding="6,2">
                                    <Label Text="{Binding BlackPlayer}" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                                </Border>
                            </HorizontalStackLayout>

                            <Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding PGN}" 
                                   TextColor="#808080" 
                                   LineBreakMode="TailTruncation" 
                                   MaxLines="1" 
                                   FontSize="12" 
                                   VerticalOptions="Center"/>

                            <Button Grid.Row="2" Grid.Column="1"
                                    Text="📋 PGN"
                                    FontSize="12"
                                    HeightRequest="35"
                                    Padding="10,0"
                                    BackgroundColor="#3E3E3E"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HorizontalOptions="End"
                                    
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArchiveViewModel}}, Path=CopyPgnCommand}"
                                    CommandParameter="{Binding PGN}"/>
                        </Grid>
                    </Border>
                    
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                    <Label Text="📭" FontSize="60" HorizontalOptions="Center"/>
                    <Label Text="Архів порожній" TextColor="Gray" FontSize="18"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
